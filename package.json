{
  "name": "veilforge",
  "productName": "Veilforge",
  "version": "1.0.0",
  "description": "Veilforge — The Last Workshop. A duskbound idle RPG.",
  "author": "Veilforge",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node js/data/selftest.mjs",
    "web": "python3 -m http.server 8080",
    "pack": "node scripts/pack-web.mjs",
    "icons": "node scripts/icons.mjs",
    "electron": "npm run pack && electron electron/main.cjs",
    "dist": "npm run pack && electron-builder --publish never",
    "dist:linux": "npm run pack && electron-builder --linux dir AppImage --publish never",
    "dist:win": "npm run pack && electron-builder --win nsis --publish never",
    "dist:mac": "npm run pack && electron-builder --mac dmg --publish never",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run pack && npx cap sync",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.veilforge.idle",
    "productName": "Veilforge",
    "copyright": "Copyright © Veilforge",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "branding"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "branding/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "branding/icon.png",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "branding/icon.png",
      "category": "public.app-category.games",
      "target": ["dmg"]
    },
    "linux": {
      "icon": "branding/icon.png",
      "category": "Game",
      "target": ["AppImage", "dir"]
    }
  }
}
